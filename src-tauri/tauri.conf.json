{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schemas/main/schemas/tauri.conf.schema.json",
  "productName": "Lamina",
  "version": "0.1.0",
  "identifier": "com.lamina.workstation",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lamina Clinical Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "global-shortcut": {}
  }
}
